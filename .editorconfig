# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

# PowerShell files
[*.ps1]
indent_style = space
indent_size = 4
max_line_length = 120

# Bash/Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2
max_line_length = 120

# YAML files (Sigma rules, docker-compose, GitHub workflows)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# XML files (Sysmon config)
[*.xml]
indent_style = space
indent_size = 2

# Dockerfile
[Dockerfile]
indent_style = space
indent_size = 2

# Makefile (must use tabs)
[Makefile]
indent_style = tab
indent_size = 4

# Git config files
[.gitconfig]
indent_style = tab

# Windows-specific files (if any)
[*.{cmd,bat}]
end_of_line = crlf
indent_style = space
indent_size = 2
